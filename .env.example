# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. Never commit real secrets.

# --- Plaid ---
# Get these from https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_production_secret_here
# One of: sandbox, production
PLAID_ENV=production
# Comma-separated. Restricts what Plaid Link offers and what we'll request.
PLAID_PRODUCTS=investments
# Comma-separated. Plaid requires at least one country.
PLAID_COUNTRY_CODES=US

# --- Encryption key for storing Plaid access tokens at rest ---
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Database ---
DATABASE_URL=sqlite:///./portfolio.db

# --- API server ---
# Comma-separated origins allowed to call the FastAPI backend.
# Vite dev server runs on 5173 by default.
CORS_ORIGINS=http://localhost:5173

# --- CIO advisor (optional) ---
# Directory containing the out-of-repo `claude_cli.py` subprocess wrapper,
# which routes Claude calls through your Pro/Max subscription instead of the
# metered API. Leave unset to disable the advisor's LLM features (chat +
# monthly brief); the rest of the app works without it.
# Example: CLAUDE_CLI_DIR=/path/to/agent-runtime/snippets
CLAUDE_CLI_DIR=

# --- Monthly brief email (optional) ---
# Where to send the monthly brief (jobs.email_brief sends it the first
# Saturday of each month). PII — keep it here, never commit. If unset, the
# email job refuses to send.
BRIEF_EMAIL_RECIPIENT=
# Google OAuth artifacts for Gmail send. Defaults (below) resolve to the repo
# root and are gitignored. Reuse the same credentials.json as other Google-API
# projects on this machine, then mint this project's token once with:
#   python -m portfolio_tracker.jobs.email_brief --authorize
# GOOGLE_CREDENTIALS_PATH=credentials.json
# GOOGLE_TOKEN_PATH=token.json
