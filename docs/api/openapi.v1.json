      "EquityFractionV1": {
        "description": "The SC-3 versioned Positioning fact (PRD \u00a77.2).\n\n``equity_fraction`` is a FRACTION in [0, 1] (``unit`` says so explicitly);\nNone when the denominator is zero or there is no data \u2014 never silently 0.",
        "properties": {
          "cash_equivalent_policy": {
            "title": "Cash Equivalent Policy",
            "type": "string"
          },
          "denominator_value": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Denominator Value",
            "type": "string"
          },
          "equity_fraction": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Equity Fraction"
          },
          "equity_value": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Equity Value",
            "type": "string"
          },
          "excluded_account_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Excluded Account Ids",
            "type": "array"
          },
          "holdings_as_of": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Holdings As Of"
          },
          "included_account_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Included Account Ids",
            "type": "array"
          },
          "is_partial": {
            "title": "Is Partial",
            "type": "boolean"
          },
          "is_stale": {
            "title": "Is Stale",
            "type": "boolean"
          },
          "methodology": {
            "title": "Methodology",
            "type": "string"
          },
          "methodology_version": {
            "title": "Methodology Version",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/V1Warning"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "equity_value",
          "denominator_value",
          "equity_fraction",
          "unit",
          "cash_equivalent_policy",
          "included_account_ids",
          "excluded_account_ids",
          "holdings_as_of",
          "is_partial",
          "is_stale",
          "warnings",
          "methodology",
          "methodology_version"
