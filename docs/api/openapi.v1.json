            "title": "Tax Treatment",
            "type": "string"
          },
          "tax_treatment_confidence": {
            "title": "Tax Treatment Confidence",
            "type": "string"
          },
          "tax_treatment_evidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
