  "info": {
    "description": "Versioned consumer-read contract for portfolio facts. See docs/api/v1-overview.md for envelope and freshness semantics.",
    "title": "Portfolio Data Service API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/accounts": {
      "get": {
        "description": "Normalized accounts: canonical identity, inclusion state, detailed Tax\ntreatment with evidence, per-account value + observation date, freshness.",
        "operationId": "accounts_api_v1_accounts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsV1Result"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Accounts",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/analytics/positioning": {
      "get": {
        "operationId": "analytics_positioning_api_v1_analytics_positioning_get",
        "parameters": [
          {
            "in": "query",
            "name": "start_date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start Date"
            }
          },
          {
            "in": "query",
            "name": "end_date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PositioningV1Result"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analytics Positioning",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthV1"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/portfolio-snapshot": {
      "get": {
        "description": "The bulk consumer read model \u2014 accounts, positions, five-way tax-bucket\ntotals, and the versioned equity fraction in one consistent read.",
        "operationId": "portfolio_snapshot_api_v1_portfolio_snapshot_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioSnapshotV1"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Portfolio Snapshot",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/portfolio/positions": {
      "get": {
        "description": "Consolidated positions with server-computed weights + per-lot tax bucket.\n\nEach position is rolled up across every account holding the security (same\nconsolidation the Holdings view uses), with ``percent_of_portfolio`` and a\n4-way ``tax_treatment`` per account lot computed server-side. Returns an\nempty-but-valid payload when there are no active holdings.",
        "operationId": "positions_api_v1_portfolio_positions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PositionsV1Result"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Positions",
        "tags": [
          "positions-v1"
        ]
      }
    }
  }
}
