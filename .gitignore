# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
token.json
*secret*
*.secret

# Database
*.db
*.db-journal
# Any sidecar of the live DB. `*.db` / `*.bak` alone miss the ones with a
# trailing label (portfolio.db.bak.positioning, portfolio.db.pre-0016-migration.bak)
# — those carry real holdings and balances and were sitting untracked, one
# `git add -A` from being committed.
portfolio.db.*
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
venv/
.venv/
env/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
*.log
npm-debug.log*
# TypeScript composite-project intermediate artifacts (vite.config.ts
# is built via tsconfig.node.json with composite:true, which emits
# .d.ts + .js next to the source). Regenerable; never commit.
frontend/vite.config.d.ts
frontend/vite.config.js

# Cron / scheduler logs from local task scheduler
scripts/logs/

# IDE / local dev tooling
.vscode/
.idea/
.claude/
*.swp

# OS
.DS_Store
Thumbs.db

# Local state
.tmp/
.cache/
data/
backups/

# Source tax PDFs — contain SSN digits, full account numbers, addresses
tax_forms/
*.bak

# Personal / portfolio-specific files — kept LOCAL, never committed. The repo
# ships generic templates (CIO_CONTEXT.example.md, scripts/import_1099_example.py);
# your real names, account numbers, tax detail, and persona live in these.
# See README "Privacy — what stays local".
scripts/private/
CIO_CONTEXT.md
CIO_CONTEXT.local.md
*.local.md
